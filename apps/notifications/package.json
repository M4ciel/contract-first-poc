{
  "name": "@acme/notifications",
  "version": "0.0.0",
  "private": true,
  "description": "Event consumer: an AWS Lambda that reads loan.created.v1 from SQS and schedules a return reminder.",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1156.0",
    "@aws-sdk/lib-dynamodb": "3.1156.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.164"
  },
  "nx": {
    "tags": [
      "type:app"
    ],
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/dist"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "command": "tsdown"
        }
      },
      "test": {
        "options": {
          "env": {
            "NODE_OPTIONS": "--experimental-vm-modules --no-warnings=ExperimentalWarning"
          }
        }
      },
      "typecheck": {}
    }
  }
}
