{
  "name": "@acme/api",
  "version": "0.0.0",
  "private": true,
  "description": "Library backend (NestJS + Fastify) that implements the Acme Library API contract.",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@acme/api-types": "workspace:*",
    "@acme/domain": "workspace:*",
    "@acme/inventory-client": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "fastify": "5.11.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "msw": "3.0.4",
    "tsc-alias": "1.9.9"
  },
  "nx": {
    "tags": [
      "type:app"
    ],
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "command": "tsc -p tsconfig.app.json && tsc-alias -p tsconfig.app.json"
        }
      },
      "serve": {
        "executor": "nx:run-commands",
        "continuous": true,
        "dependsOn": [
          "build"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "command": "node --enable-source-maps dist/main.js"
        }
      },
      "test": {
        "options": {
          "env": {
            "NODE_OPTIONS": "--experimental-vm-modules --no-warnings=ExperimentalWarning"
          }
        }
      },
      "typecheck": {}
    }
  }
}
