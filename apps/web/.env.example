# Copy to .env.local (git-ignored) to set these for `nx run @acme/web:serve`.

# Answer the API with the contract's generated MSW handlers (no backend, no Flagsmith).
VITE_USE_MOCKS=false

# Feature flags from the local Flagsmith (`nx run @acme/infra:up`). Example key seeded by
# infra/flagsmith/seed.py; without it, flags come from the VITE_FLAG_* values below.
VITE_FLAGSMITH_ENVIRONMENT_KEY=acmeLocalClientKey
VITE_FLAGSMITH_API_URL=http://localhost:8000/api/v1/

# Fixed flag values, used in mock mode or without a Flagsmith key.
VITE_FLAG_BOOKS_V2=false

# Backend the dev server forwards /v1 and /v2 to.
API_PROXY_TARGET=http://localhost:3000
