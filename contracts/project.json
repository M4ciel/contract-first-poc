{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "contracts",
  "projectType": "library",
  "sourceRoot": "contracts",
  "tags": ["scope:contracts"],
  "namedInputs": {
    "contract": [
      "{projectRoot}/apis/**/*",
      "{projectRoot}/shared/**/*",
      "{projectRoot}/events/asyncapi.yaml",
      "{projectRoot}/redocly.yaml",
      "{projectRoot}/.redocly.lint-ignore.yaml",
      {
        "externalDependencies": ["@redocly/cli"]
      }
    ],
    "generator": [
      "{projectRoot}/orval.config.ts",
      "{projectRoot}/tooling/**/*",
      "{projectRoot}/packages/*/src/http/**/*",
      {
        "externalDependencies": ["orval"]
      }
    ],
    "events": [
      "{projectRoot}/events/**/*",
      {
        "externalDependencies": ["json-schema-to-typescript"]
      }
    ]
  },
  "targets": {
    "contract-lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["contract"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "redocly lint",
        "env": {
          "REDOCLY_TELEMETRY": "off",
          "REDOCLY_SUPPRESS_UPDATE_NOTICE": "true"
        }
      }
    },
    "bundle": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["contract-lint"],
      "inputs": ["contract"],
      "outputs": [
        "{projectRoot}/artifacts/library.bundle.yaml",
        "{projectRoot}/artifacts/inventory.bundle.yaml",
        "{projectRoot}/artifacts/events"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "redocly bundle",
        "env": {
          "REDOCLY_TELEMETRY": "off",
          "REDOCLY_SUPPRESS_UPDATE_NOTICE": "true"
        }
      }
    },
    "generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["bundle"],
      "inputs": ["contract", "generator", "events"],
      "outputs": [
        "{projectRoot}/packages/api-types/src/generated",
        "{projectRoot}/packages/api-client/src/generated",
        "{projectRoot}/packages/inventory-client/src/generated",
        "{projectRoot}/packages/events/src/generated"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "orval --config orval.config.ts && node tooling/generate/apply-response-enum-fallback.ts && node tooling/generate/generate-events.ts"
      }
    },
    "test": {
      "options": {
        "env": {
          "NODE_OPTIONS": "--experimental-vm-modules --no-warnings=ExperimentalWarning"
        }
      },
      "dependsOn": ["oasdiff-install"]
    },
    "typecheck": {},
    "oasdiff-install": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{projectRoot}",
        "command": "bash tooling/compat/install-oasdiff.sh"
      }
    },
    "compat": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["bundle", "oasdiff-install"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "bash tooling/compat/check-compatibility.sh"
      }
    },
    "reference": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["bundle"],
      "inputs": ["contract", "{projectRoot}/tooling/reference/build-reference.ts"],
      "outputs": ["{projectRoot}/artifacts/reference"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "node tooling/reference/build-reference.ts"
      }
    }
  }
}
