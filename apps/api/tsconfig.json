{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    // One alias per folder of src/. `tsc-alias` rewrites them to relative paths in `dist`, and
    // Jest reads them through jest.paths.cjs.
    "paths": {
      "@app/*": ["./src/app/*"],
      "@books/*": ["./src/books/*"],
      "@cloud/*": ["./src/cloud/*"],
      "@common/*": ["./src/common/*"],
      "@config/*": ["./src/config/*"],
      "@events/*": ["./src/events/*"],
      "@health/*": ["./src/health/*"],
      "@inventory/*": ["./src/inventory/*"],
      "@loans/*": ["./src/loans/*"],
      "@problems/*": ["./src/problems/*"],
      "@testing/*": ["./src/testing/*"]
    },
    // NestJS dependency injection reads constructor types from decorator metadata.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node", "jest"]
  },
  "include": ["src/**/*.ts"]
}
