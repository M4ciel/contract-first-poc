{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "contracts",
  "projectType": "library",
  "sourceRoot": "contracts",
  "tags": ["scope:contracts"],
  "namedInputs": {
    "contract": [
      "{projectRoot}/apis/**/*",
      "{projectRoot}/shared/**/*",
      "{projectRoot}/redocly.yaml",
      "{projectRoot}/.redocly.lint-ignore.yaml",
      {
        "externalDependencies": ["@redocly/cli"]
      }
    ]
  },
  "targets": {
    "contract-lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["contract"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "redocly lint",
        "env": {
          "REDOCLY_TELEMETRY": "off",
          "REDOCLY_SUPPRESS_UPDATE_NOTICE": "true"
        }
      }
    },
    "bundle": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["contract-lint"],
      "inputs": ["contract"],
      "outputs": ["{projectRoot}/artifacts/library.bundle.yaml"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "redocly bundle",
        "env": {
          "REDOCLY_TELEMETRY": "off",
          "REDOCLY_SUPPRESS_UPDATE_NOTICE": "true"
        }
      }
    }
  }
}
