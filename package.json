{
  "name": "@acme/source",
  "version": "0.0.0",
  "private": true,
  "description": "Contract-first architecture with generated, versioned packages (proof of concept).",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "24.22.2",
    "pnpm": "12.18.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "contract:lint": "nx run contracts:contract-lint",
    "contract:bundle": "nx run contracts:bundle",
    "generate": "nx run contracts:generate",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "graph": "nx graph",
    "build": "nx run-many -t build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.6.0",
    "@nx/eslint": "24.0.4",
