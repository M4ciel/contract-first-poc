{
  "name": "@acme/tools",
  "version": "0.0.0",
  "private": true,
  "description": "Repository-wide checks: global test coverage, changesets, the software catalog and the clean-clone check.",
  "license": "MIT",
  "type": "module",
  "nx": {
    "tags": [
      "type:tool"
    ],
    "targets": {
      "coverage": {
        "executor": "nx:run-commands",
        "dependsOn": [
          {
            "projects": [
              "*"
            ],
            "target": "test"
          }
        ],
        "options": {
          "command": "node tools/src/check-coverage.ts"
        }
      },
      "clean-clone": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "bash tools/src/clean-clone.sh"
        }
      },
      "test": {
        "options": {
          "env": {
            "NODE_OPTIONS": "--experimental-vm-modules --no-warnings=ExperimentalWarning"
          }
        }
      },
      "typecheck": {},
      "catalog-check": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{workspaceRoot}/catalog-info.yaml",
          "{workspaceRoot}/**/catalog-info.yaml",
          "{workspaceRoot}/contracts/catalog/**/*",
          "{workspaceRoot}/apps/*/package.json",
          "{workspaceRoot}/contracts/packages/*/package.json",
          "{workspaceRoot}/tools/src/catalog-check*.ts"
        ],
        "options": {
          "command": "node tools/src/catalog-check.ts"
        }
      },
      "changeset-check": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node tools/src/changeset-check.ts"
        }
      },
      "actionlint": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{workspaceRoot}/.github/**/*"
        ],
        "options": {
          "cwd": "{workspaceRoot}",
          "command": "docker run --rm -v \"$PWD:/repo\" -w /repo rhysd/actionlint:1.7.12@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667 -color"
        }
      }
    }
  },
  "devDependencies": {
    "yaml": "2.9.1"
  }
}
